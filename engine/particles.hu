#ifndef PARTICLES_H
#define PARTICLES_H

#include "typedefs.h"
#include "cudaVec.hu"
#include "grid.hpp"
#include "partitionContext.hu"
#include "forces.hu"
#include "sources.hu"
#include "obstacles.hu"
#include "algorithms/conjugateGradientFunctions.hu"
#include <string>
#include <vector>

class Transport;
struct FrameDiagnostics;

enum class PressureSolver{
    sor,        //red/black SOR
    cg,         //conjugate gradient
    jacobi,     //conjugate gradient, Jacobi-preconditioned
    multigrid   //conjugate gradient, preconditioned by a multigrid V-cycle
};

//The particles in one partition of the domain, and the grid they need: the nodes they occupy, the empty nodes their stencils reach into, and, when the
//domain is split between partitions, copies of the neighbouring partitions' nodes next to its own (ghost nodes, with the same sparse voxels their owners
//store). A partition owns the node planes [partitionPlanes[rank], partitionPlanes[rank + 1]) along z. On its own, a partition is the whole domain
class Particles{
public:
    Particles(uint size);

    //makes this partition rank of numRanks, which run in lockstep, exchanging through the transport; the solver's exchanges go through the context. Before setDomain
    void setPartition(int rank, int numRanks, Transport* transport, PartitionContext* context, const std::vector<uint>& planes);

    void setDomain(double nx, double ny, double nz, uint x, uint y, uint z, double cellSize);

    void alignParticlesToGrid();

    void sortParticles();

    void generateVoxels();

    void particleVelToVoxels();

    void setupCudaDevices();

    void pressureSolve();

    void updateVoxelVelocities();

    void advectParticles();

    void solveFrame(double fps);

    void initialize();
    
    void voxelVelsToParticles();

    const float* packPositions();   //float32 x, y, z per particle, for a frame, on this partition's GPU; valid for the work queued on its stream after this
    void copyPositionsToHost(float* xyz, cudaEvent_t copied);   //the same, into pinned xyz, recording copied once it's there

    uint numParticles() const{
        return size;
    }

    int device() const{     //the GPU this partition runs on: the current one when it was made
        return cudaDevice;
    }

    double getCourantDt();

    void setRestDensity(double particlesPerVoxel){  //the particle density the density correction holds the fluid at, normally what the particles were seeded at
        restParticlesPerVoxel = particlesPerVoxel;
    }

    void setDensityCorrectionTime(double seconds){  //how quickly the fluid's particle density is pulled back to rest (0 turns the correction off)
        densityCorrectionTime = seconds;
    }

    void setPressureSolver(PressureSolver solver){
        pressureSolver = solver;
    }

    //how CG adds up its dot products: exactly (the default), so runs match bit for bit however the nodes are split between GPUs, or per thread block,
    //the original, which repeats only for one split and may be a little faster. Kept so the exact sums can be backed out if they cost too much
    void setDotProductSums(DotProductSums sums){
        dotProductSums = sums;
    }

    void setFlipRatio(double ratio){    //the particle velocity update's share of FLIP, the rest PIC: 1 keeps the most energy and detail, 0 is the most damped and stable
        flipRatio = ratio;
    }

    void setCfl(double voxels){ //how far the fastest particle may move per substep, in voxels
        cfl = voxels;
    }

    void setRungeKutta3(bool on){   //advect particles through the grid with RK3 (the default), or straight along its velocity (forward Euler)
        rungeKutta3 = on;
    }

    void setGravity(float3 gravity){    //m/s^2; (0, -9.8, 0) by default
        forces.gravity = gravity;
    }

    void setSources(const Sources& emittersAndSinks){   //what adds fluid and what takes it away (see sources.hu)
        sources = emittersAndSinks;
    }

    void setObstacles(const std::vector<SceneObstacle>& descriptions);  //what the fluid flows around (see obstacles.hu); after setDomain

    void setForceFields(const std::vector<ForceField>& fields){   //the force fields besides gravity, up to MAX_FORCE_FIELDS of them (see forces.hu)
        forces.numFields = 0;
        for(const ForceField& field : fields){
            if(forces.numFields == MAX_FORCE_FIELDS){
                std::cerr<<"Particles: only the first "<<MAX_FORCE_FIELDS<<" force fields act\n";
                break;
            }
            forces.fields[forces.numFields++] = field;
        }
    }

    ~Particles();
private:
    void exchangeParticles();
    ForceVoxels forceVoxels();
    void resizeParticleArrays(uint newSize, uint keep);
    void markRemovedParticles();
    void killRemovedParticles();
    void dropRemovedParticles();
    void emitParticles();
    void pinEmitterVelocities();
    bool removing() const;      //whether this initialize removes any particles: sinks, open faces, or at the start, fluid inside obstacles
    void updateObstacles();
    void pushOutParticles();
    void markParticlesInsideObstacles();
    void markObstacleSolids();
    void addObstacleFlux();
    void obstacleGhostVelocities();
    void creditObstacleVolume();
    VoxelPlaces voxelPlaces();
    void receiveParticleNodes(uint maskWords);
    void orderNodes(uint maskWords);
    void checkGhostRuns();
    bool verbose() const{   //only one partition reports the values every partition shares
        return rank == 0;
    }

    CudaVec<double> px, py, pz;    //positions stay double: in a large domain, float would round a slow particle's step away
    CudaVec<float> vx, vy, vz;
    CudaVec<uint> gridCell;
    CudaVec<char> solids;
    CudaVec<float> p;
    CudaVec<float> residuals;

    CudaVec<uint> reorderedGridIndices;

    CudaVec<uint> uniqueGridNodeIndices;
    CudaVec<uint> gridNodeIndicesToFirstParticleIndex;

    CudaVec<uint> nodeIndexUsedVoxels;
    CudaVec<uint> voxelIDsUsed;
    CudaVec<uint> voxelOwners;  //per used voxel: index of the used voxel holding its value (itself, or the neighbouring node's interior copy for apron voxels)
    CudaVec<uint> nodeCells;    //used node -> its grid cell
    CudaVec<uint> cellToNode;   //grid cell -> used node index; never cleared, so entries are checked against nodeCells before use
    CudaVec<uint> nodeCount;    //counts nodes as the empty ones are appended

    CudaVec<float> divU;

    CudaVec<float> voxelsUx;
    CudaVec<float> voxelsUy;
    CudaVec<float> voxelsUz;
    CudaVec<float> voxelsUxOld;    //the grid velocities before gravity and the pressure solve, for FLIP
    CudaVec<float> voxelsUyOld;
    CudaVec<float> voxelsUzOld;

    CudaVec<float> voxelWeightsX;  //P2G weight sums
    CudaVec<float> voxelWeightsY;
    CudaVec<float> voxelWeightsZ;
    CudaVec<float> particleCounts; //P2G: the particles in each voxel
    CudaVec<char> footprintDepth;   //per voxel: how many voxels inside the fluid's footprint it is, up to CORRECTION_DEPTH
    CudaVec<uint> freeSurface;      //whether any pressure unknown touches air

    CudaVec<float> Anx;
    CudaVec<float> Apx;
    CudaVec<float> Any;
    CudaVec<float> Apy;
    CudaVec<float> Anz;
    CudaVec<float> Apz;
    CudaVec<float> Adiag;

    CudaVec<uint> neighborNx;   //per pressure unknown: the used voxel owning each face neighbour (NO_VOXEL air, WALL_VOXEL outside the domain). Per air voxel
                                //above an unknown, the lower ones hold that unknown: the face between them is the air voxel's to update (NO_VOXEL otherwise)
    CudaVec<uint> neighborPx;
    CudaVec<uint> neighborNy;
    CudaVec<uint> neighborPy;
    CudaVec<uint> neighborNz;
    CudaVec<uint> neighborPz;
    CudaVec<char> solveCodes;   //per used voxel: 0 if not a pressure unknown, else 1 red / 2 black
    CudaVec<uint> coarseCells;  //per pressure unknown: the multigrid's first coarse cell holding it
    CudaVec<uint> nodeInteriorVoxels;   //per node, its interior's voxels (x fastest): each one's index among the stored voxels, or NO_VOXEL

    CudaVec<uint> usedVoxelMasks;   //per node: stored, fluid and reached masks, one bit per slot of its voxel block
    CudaVec<uint> particleNodeMasks;    //per node holding this partition's particles: the voxels they reach, as markReachedVoxels finds them
    CudaVec<uint> foreignParticleNodeMasks; //the same, for the neighbouring partitions' particle nodes received by receiveParticleNodes
    CudaVec<char> nodeHasParticles;     //per used node: whether it holds particles, here or in the partition that owns it
    CudaVec<uint> nodeOrigins;          //orderNodes' working space: each node's index before it was put in order

    //The voxels neighbouring partitions exchange, by side: 0 the partition below, 1 the one above. A partition keeps each boundary plane's nodes as a run
    //holding particles and a run of empty ones, each in cell order, and orders its ghost copies of a neighbour's plane the same way, so filling ghosts is
    //copying two runs, whose voxels are consecutive. Matching runs must agree in nodes and voxels, which checkGhostRuns makes sure of
    struct VoxelRun{
        uint firstNode = 0;
        uint nodes = 0;
        uint start = 0;     //its voxels
        uint count = 0;
    };
    VoxelRun edgeParticles[2];  //its own nodes holding particles in plane boxLo (side 0) and in plane boxHi - 1 (side 1)
    VoxelRun edgeEmpty[2];      //its own empty nodes there
    VoxelRun ghostParticles[2]; //its ghost nodes holding particles, in plane boxLo - 1 (side 0) and in plane boxHi (side 1)
    VoxelRun ghostEmpty[2];     //its empty ghost nodes there, straight after them

    //the nodes, in this order: [0, numParticleNodes) this partition's holding particles; up to numOwnNodes its empty ones; up to numStoredNodes its ghost
    //nodes; up to numUsedGridNodes the neighbours' particle nodes 2 planes out, which store no voxels but whose particles make ghost voxels fluid.
    //Every voxel array holds the own nodes' voxels first, numOwnVoxels of them, then the ghosts'
    uint numUsedGridNodes;
    uint numParticleNodes;
    uint numForeignParticleNodes = 0;   //received, while the nodes are being ordered
    uint numOwnNodes = 0;
    uint numStoredNodes = 0;
    uint numOwnVoxels = 0;
    uint numUsedVoxelsX;
    uint numUsedVoxelsY;
    uint numUsedVoxelsZ;
    uint totalNumParticlesInPerVoxelListsX;
    uint totalNumParticlesInPerVoxelListsY;
    uint totalNumParticlesInPerVoxelListsZ;

    uint refinementLevel;
    uint numVoxelsPerNode;
    uint numVoxels1D;
    uint size;
    double radius;
    double flipRatio = 0.95;
    double cfl = 4.0;   //RK3 advection holds up to 4: past it, its stages reach beyond advectThroughGrid's 3-node tile
    bool rungeKutta3 = true;
    PressureSolver pressureSolver = PressureSolver::multigrid;
    DotProductSums dotProductSums = DotProductSums::exact;
    double maxVelocity = 0.0;   //the fastest particle velocity component, found each substep by P2G
    Forces forces;              //gravity and the force fields
    Sources sources;            //emitters, sinks and open faces
    CudaVec<char> removedFlags; //per particle, while initialize runs: whether a sink or an open face takes it
    ObstacleSet obstacles;      //what the fluid flows around
    CudaVec<char> obstacleSolids;   //per stored voxel: whether its centre is inside an obstacle
    unsigned long long substepIndex = 0;    //substeps taken, which seeds the emitters' jitter
    double restParticlesPerVoxel = 8.0;
    double densityCorrectionTime = 0.1;
    Grid grid;

    double frameDt; //overall timestep used for writing particle positions
    double dt; //timestep used in pressure solve
    double prevDt;
    double elapsedTime = 0.0;
    double elapsedTimeThisFrame;
    uint substepsThisFrame = 0;     //for diagnostics: the substeps the last frame took, and their smallest and largest dt
    double smallestDtThisFrame = 0.0;
    double largestDtThisFrame = 0.0;

    int cudaDevice = 0;
    cudaStream_t stream;
    std::vector<cudaDeviceProp> deviceProp;

    CudaVec<float> framePositions;          //a frame's x, y, z, packed for the copy to the host
    cudaStream_t frameStream = nullptr;     //copies frames to the host alongside the simulation
    cudaEvent_t framePacked = nullptr;
    cudaEvent_t frameCopied = nullptr;      //framePositions has been copied out, so it can take the next frame
    std::vector<uint> selectedDevices;

    //the partition: this is rank of numRanks, owning node planes [boxLo, boxHi). Partitions exchange through the transport, and the solver's exchanges go
    //through the context, which does nothing for a lone partition
    int rank = 0;
    int numRanks = 1;
    Transport* transport = nullptr;
    PartitionContext loneContext;
    PartitionContext* context = &loneContext;
    std::vector<uint> partitionPlanes;  //partition r owns node planes [partitionPlanes[r], partitionPlanes[r + 1])
    uint boxLo = 0;
    uint boxHi = 0;
    bool distributed = false;           //whether it has dropped the particles other partitions own; at first every partition holds all of them
    uint particlesBelow = 0;            //after the sort: how many particles are in the planes below this partition's, and above, on their way out
    uint particlesAbove = 0;
    uint lowerBoundaryParticleNodes = 0;    //how many of its particle nodes lie within 2 planes of the partition below it's, and above it's
    uint upperBoundaryParticleNodes = 0;

    friend class ParticleSystemTester;
    friend class PartitionExchange;
    friend class Simulation;
    friend FrameDiagnostics computeFrameDiagnostics(Particles& partition);
};

#endif