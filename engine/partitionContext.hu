#ifndef PARTITIONCONTEXT_HU
#define PARTITIONCONTEXT_HU

#include "typedefs.h"
#include <cstddef>

//What one partition of a simulation needs from the others. The domain's node planes are split between partitions, each owning its nodes and the
//particles in them, and holding copies of the neighbouring partitions' nodes next to its own: ghost nodes, with the same sparse voxels their owners
//store. Every voxel array holds the partition's own voxels first, then its ghosts'. The partitions run the same steps in lockstep, so every call here
//is made by all of them, in the same order. A partition on its own has no one to exchange with, and these do nothing
class PartitionContext{
public:
    virtual ~PartitionContext() = default;

    //ghost voxels take their owners' values
    virtual void fillGhosts(float* values, cudaStream_t stream){}
    virtual void fillGhosts(char* values, cudaStream_t stream){}

    //owners add their ghost copies' values into their own: the sums P2G made from other partitions' particles, in fixed point
    virtual void reduceGhosts(int* values, cudaStream_t stream){}

    //over every partition, the same result in each: the largest value, and whether any is set
    virtual double maxOverPartitions(double value){
        return value;
    }
    virtual bool anyOverPartitions(bool value){
        return value;
    }

    //sums on the device over every partition, in place: 64-bit integers, which add up the same in any order, or a double, added in partition order
    virtual void sumOverPartitions(long long* values, uint count, cudaStream_t stream){}
    virtual void sumOverPartitions(double* value, cudaStream_t stream){}

    //the multigrid's first coarse grid is dense over the whole domain, and each partition fills in the cells in its own node planes: take the rest from
    //the partitions they belong to
    virtual void gatherFirstLevel(void* cells, size_t bytesPerCell, cudaStream_t stream){}
};

#endif
