#ifndef LOCALEXCHANGE_HU
#define LOCALEXCHANGE_HU

#include "partitionContext.hu"
#include <condition_variable>
#include <mutex>
#include <vector>

class Particles;

static const int MAX_PARTITIONS = 16;

//The partitions of one simulation in one process, like ranks: each driven by its own host thread, on its own stream, on one GPU or on several. Host
//barriers order the partitions' host code and events order their GPU work. An exchange goes: each partition records that what it lends out is ready,
//a barrier, each waits for its peers' readiness and copies what it needs from them on its own stream, records that it's done reading, a barrier, and
//each waits for its peers to finish reading before it changes anything they read. Data only crosses between partitions in cudaMemcpyPeerAsync copies,
//never in kernels, so partitions can sit on different GPUs with or without peer access (without it, the driver stages the copies through the host)
class LocalExchange{
public:
    explicit LocalExchange(int numPartitions);
    ~LocalExchange();

    int size() const{
        return numPartitions;
    }
    void barrier();

    //registers a partition, and makes its events and scratch space on its GPU, which must be the current one
    void attach(int rank, Particles* partition);
    Particles& partition(int rank){
        return *partitions[rank];
    }

    //a pointer or value from each partition, which every partition can read after the next barrier
    void publish(int rank, const void* pointer){
        pointers[rank] = pointer;
    }
    const void* published(int rank) const{
        return pointers[rank];
    }
    void publishValue(int rank, double value){
        values[rank] = value;
    }
    double publishedValue(int rank) const{
        return values[rank];
    }

    //each partition's scratch space on its GPU: a slot of SCRATCH_WORDS 64-bit words per partition
    static constexpr unsigned int SCRATCH_WORDS = 64;
    long long* scratch(int rank){
        return scratchSpace[rank];
    }

    //An exchange between rank and its peers, which are both the partitions it reads from and the ones that read from it: startReads, copyFrom the
    //peers, finishReads. Both include a barrier, so every partition takes part
    void startReads(int rank, const std::vector<int>& peers);
    void copyFrom(int rank, void* destination, int from, const void* source, size_t bytes);
    void finishReads(int rank, const std::vector<int>& peers);
    std::vector<int> neighbours(int rank) const;    //the partitions next to rank's planes
    std::vector<int> everyone() const;

private:
    int numPartitions;
    std::mutex mutex;
    std::condition_variable released;
    int arrived = 0;
    unsigned long long generation = 0;
    std::vector<Particles*> partitions;
    std::vector<int> devices;
    std::vector<cudaStream_t> streams;
    std::vector<cudaEvent_t> ready;     //recorded on each partition's stream when what it lends out is written
    std::vector<cudaEvent_t> consumed;  //recorded when its copies from its peers are done
    std::vector<const void*> pointers;
    std::vector<double> values;
    std::vector<long long*> scratchSpace;
};

//one partition's side of a LocalExchange. With a single partition every call returns straight away, so a lone partition runs exactly as it always has
class LocalPartition : public PartitionContext{
public:
    LocalPartition(LocalExchange& exchange, int rank)
    : exchange(exchange)
    , rank(rank)
    {}
    ~LocalPartition();  //frees its buffers: make its GPU the current one first

    void fillGhosts(float* values, cudaStream_t stream) override;
    void fillGhosts(char* values, cudaStream_t stream) override;
    void reduceGhosts(int* values, cudaStream_t stream) override;
    double maxOverPartitions(double value) override;
    bool anyOverPartitions(bool value) override;
    void sumOverPartitions(long long* values, uint count, cudaStream_t stream) override;
    void sumOverPartitions(double* value, cudaStream_t stream) override;
    void gatherFirstLevel(void* cells, size_t bytesPerCell, cudaStream_t stream) override;

private:
    template <typename T>
    void fill(T* values, cudaStream_t stream);
    int* reduceBuffer(int side, uint count, cudaStream_t stream);

    LocalExchange& exchange;
    int rank;
    int* reduceBuffers[2] = {nullptr, nullptr};     //a neighbour's ghost copies of this partition's voxels, to add in; on this partition's GPU
    uint reduceBufferSizes[2] = {0, 0};
};

#endif
