#ifndef CACHEWRITER_HU
#define CACHEWRITER_HU

#include "typedefs.h"
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <functional>
#include <mutex>
#include <queue>
#include <string>
#include <thread>
#include <vector>

//A bake's cache, written while it runs and readable while it does. In the output directory:
//
//  cache.json                          what made it: the scene and its hash, the domain, the ranks and how the domain is split between them, the GPU and
//                                      build, the shards' format, "committed": the last frame whose commit record is down (every one before it is too),
//                                      and "checkpoint": the newest checkpoint's frame. Brought up to date at least every second, and whenever the writer has
//                                      caught up; the commit records have the last word
//  frames/0042/particles.r003.f2p      rank 3's particles at frame 42: a shard (below), written by rank 3 itself
//  frames/0042/commit.json             written last, by rank 0, once every rank's shard is on the disk: each shard's size and XXH64. A frame without one
//                                      is unfinished, and a reader skips it
//  checkpoints/0040/state.r003.f2p     rank 3's whole state at the end of frame 40, as a shard: what flip2 resume carries on from, exactly
//  checkpoints/0040/ckpt.json          written last, by rank 0, as commit.json is: the time, the substeps taken, the ranks' planes, and each state shard
//
//A shard (.f2p, version 1) is little-endian: a 64-byte header, a 64-byte entry per attribute, then each attribute's data. Header: "FLIP2SHD", version,
//attribute count, particle count (uint64), frame, rank, world size, flags, then the particles' bounds, float32 low x, y, z and high x, y, z. Attribute:
//name (16 bytes, zero padded), type (1: float32, 2: float64, 3: uint64), components, codec (0: raw, 1: blosc), 4 reserved bytes, then as uint64 the offset
//of its data from the start of the file, the data's stored size, its raw size and 8 reserved bytes. The data: each component's stored size (uint64), then
//the components, each a plane of every particle's value in the shard's order; with blosc, each plane is one blosc buffer (zstd with bit shuffle, or lz4
//with byte shuffle: blosc's own header says which, so any blosc reader takes either). A frame's attributes: "P" (position) and "v" (velocity), float32 x,
//y, z each, and unless the scene leaves them out, "id", uint64, which a particle keeps for as long as it exists and no other ever has, and "age",
//float32, the seconds since it came to be. A checkpoint's: "P" as float64, "v", with APIC "c", float32 velocity gradients (component c along axis a at
//3c + a), "id", and "birth", float32, when each particle came to be. The particles' order changes from frame to frame: the ids say which is which. Floats
//from a simulation are noisy: losslessly P and v come to about 17 bytes a particle (1.4x) with zstd and 18.5 with lz4, measured on the dam break
struct CacheDescription{
    std::string scenePath;      //as given
    std::string sceneHash;      //XXH64 of the scene file, hex
    double fps = 24.0;
    int frames = 0;             //asked for, after frame 0
    int worldSize = 1;
    std::vector<uint> partitionPlanes;  //each rank's first node plane along z, and the last one's end
    uint nodes[3] = {0, 0, 0};
    double nodeSize = 0.0;
    double voxelSize = 0.0;
    double domainMin[3] = {0.0, 0.0, 0.0};
    std::string gpu;
    int sm = 0;
    int cudaRuntime = 0;
    std::string compression = "zstd";   //the shards' planes: "zstd" or "lz4" (blosc), or "none"
    bool ids = true;            //whether the frames carry "id"
    bool ages = true;           //and "age"
    int keepCheckpoints = 2;    //the newest ones kept; older ones are deleted once a newer one is down
};

//what a checkpoint holds besides its particles: enough to carry on exactly as if the bake had never stopped
struct CheckpointState{
    double time = 0.0;                  //seconds simulated
    unsigned long long substep = 0;     //substeps taken, which seeds the emitters' jitter
    bool apic = false;                  //whether the particles carry velocity gradients ("c")
    unsigned long long nextId = 0;      //the id the next new particle gets
};

//one rank's part of a frame or a checkpoint in a host buffer: its attributes one after another (frameBytes, checkpointBytes), each a plane per component
struct CacheShard{
    int rank;
    size_t particles;
    size_t offset;      //in bytes, from the start of the buffer
};

//A shard read back whole: what flip2 resume restores a checkpoint from
struct ShardData{
    uint64_t particles = 0;
    int frame = 0;
    int rank = 0;
    int worldSize = 0;
    struct Attribute{
        std::string name;
        uint32_t type = 0;          //1 float32, 2 float64, 3 uint64
        uint32_t components = 0;
        std::vector<char> planes;   //every component's plane, raw, one after another
    };
    std::vector<Attribute> attributes;
    const Attribute* find(const std::string& name) const;
};
//reads path into out, checking it hashes to xxh64 (hex) if that's given; or says why not
bool readShard(const std::string& path, const std::string& xxh64, ShardData& out, std::string& why);
bool cacheCompresses();     //whether this build has blosc, to compress the cache's shards (and read compressed ones)

//Writes the cache's frames and checkpoints on a background thread, like FrameWriter: the caller takes a free pinned buffer with acquire(), has each of its
//partitions copy its planes in, recording an event when they land, and submits it. The thread writes each shard (compressed, hashed, flushed to the disk),
//then commits the frame or checkpoint: in the process with rank 0, once every other rank's record of its shard is there too (each process writes its own
//ranks' shards, and the others leave a record beside theirs for rank 0, which reads no shard but its own); then done("committed" or "checkpoint", frame)
//is called, from the thread
class CacheWriter{
public:
    //committedBefore: a resumed bake's frames already in the cache, the last one's number
    CacheWriter(const std::string& directory, const CacheDescription& description, const std::vector<int>& localRanks, int committedBefore,
                std::function<void(const char*, int)> done, int numBuffers = 3);
    ~CacheWriter();     //finishes every job submitted

    static size_t frameBytes(size_t particles, bool ids, bool ages){
        return (3*sizeof(float) + 3*sizeof(float) + (ids ? sizeof(uint64_t) : 0) + (ages ? sizeof(float) : 0))*particles;
    }
    static size_t checkpointBytes(size_t particles, bool apic){
        return (3*sizeof(double) + 3*sizeof(float) + (apic ? 9*sizeof(float) : 0) + sizeof(uint64_t) + sizeof(float))*particles;
    }
    bool writesIds() const{
        return description.ids;
    }
    bool writesAges() const{
        return description.ages;
    }

    int numBuffers() const{
        return (int)hostBuffers.size();
    }
    int acquire(size_t bytes);      //a free buffer's index, once one is free, holding at least bytes
    char* hostBuffer(int buffer){
        return hostBuffers[buffer];
    }
    //writes and commits frame (at time seconds in) once every event in copies has completed; the events mustn't be recorded again until the buffer is free
    void submit(int buffer, int frame, double time, const std::vector<CacheShard>& shards, const std::vector<cudaEvent_t>& copies);
    void submitCheckpoint(int buffer, int frame, const CheckpointState& state, const std::vector<CacheShard>& shards, const std::vector<cudaEvent_t>& copies);
    void flush();           //waits until every job submitted is written and committed, or has failed
    std::string error();    //what went wrong, if anything: nothing from then on is committed

private:
    struct Layout{
        std::string name;
        int components;
        int bytes;      //per value: 4 or 8
        bool integer;   //uint64, rather than a float of that many bytes
    };
    struct Job{
        bool checkpoint;
        int buffer;
        int frame;
        CheckpointState state;      //a checkpoint's; a frame's time is state.time
        std::vector<CacheShard> shards;
        std::vector<cudaEvent_t> copies;
    };
    struct ShardRecord{
        int rank = 0;
        uint64_t particles = 0;
        uint64_t bytes = 0;
        uint64_t hash = 0;
        float low[3] = {0.0f, 0.0f, 0.0f};
        float high[3] = {0.0f, 0.0f, 0.0f};
    };

    void run();
    void process(const Job& job);
    bool writeShard(const std::string& path, int frame, const CacheShard& shard, const char* data, const std::vector<Layout>& layout, ShardRecord& record);
    bool readRecord(const std::string& path, int rank, ShardRecord& record);
    std::string shardsJson(const std::vector<ShardRecord>& records, const char* base) const;
    bool commit(const std::string& frameDirectory, int frame, double time, const std::vector<ShardRecord>& records);
    bool commitCheckpoint(const std::string& checkpointDirectory, const Job& job, const std::vector<ShardRecord>& records);
    void pruneCheckpoints();
    bool describe();    //cache.json, as things are now
    std::string cacheJson() const;
    void fail(const std::string& why);

    std::string directory;
    CacheDescription description;
    std::vector<int> localRanks;
    bool commits;       //whether this process has rank 0
    std::function<void(const char*, int)> done;
    int lastCommitted = -1;
    int lastCheckpoint = -1;
    int lastDescribed = -2;     //the committed frame cache.json last said
    int checkpointDescribed = -2;   //and the checkpoint
    std::chrono::steady_clock::time_point described;    //when
    std::vector<char> scratch;  //compressed planes
    struct Timing{      //where the thread's time goes, and how long the simulation waited for a buffer; said on stderr at the end
        int frames = 0;
        int checkpoints = 0;
        double compress = 0.0, write = 0.0, flush = 0.0, commit = 0.0, waited = 0.0;
        int waits = 0;
    } timing;

    std::vector<char*> hostBuffers;
    std::vector<size_t> capacities;     //in bytes
    std::vector<int> freeBuffers;
    std::queue<Job> jobs;
    std::string failure;
    std::mutex mutex;
    std::condition_variable changed;
    bool stopping = false;
    bool busy = false;  //on a job taken off the queue
    std::thread thread;
};

#endif
